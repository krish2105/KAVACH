<?xml version="1.0" encoding="UTF-8"?>
<!--
  KAVACH voice loop as a launchd Launch Agent (spec §3 "Background service",
  §8 layout).

  Keeps the wake-word listener running at login without a Terminal window.

  ⚠️  READ docs/permissions-setup.md FIRST.

  macOS grants Accessibility / Screen Recording / Input Monitoring to the
  process that LAUNCHES a tool, not to the tool itself. A Launch Agent is its
  own process as far as TCC is concerned, so it needs its OWN grants —
  the ones you gave your terminal do not carry over. The first run will
  therefore be able to hear you but not act, until you grant it separately.

  Install:
    cp daemon/com.krishna.kavach.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.krishna.kavach.plist

  Stop / uninstall:
    launchctl unload ~/Library/LaunchAgents/com.krishna.kavach.plist

  Deliberately NOT installed by default. A background process that listens to
  the microphone and can drive your Mac should be started by a decision, not
  by a build step.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.krishna.kavach</string>

    <!-- uv resolves the project's own venv, so no interpreter path is hardcoded. -->
    <!--
      The venv interpreter directly — no `uv run` in front of it.

      TCC attributes to the *responsible* process, so with `uv run` every grant
      this loop depends on is checked against uv rather than against python.
      That silently cost the hotkeys on the overlay agent, and here it would put
      the **microphone** behind the same mistake.

      Measured from inside a launchd job before installing this:

          mic TCC status: AUTHORIZED
          mic opened: OK

      Worth stating because a bare process cannot get the *camera* at all — the
      whole of presence/appbundle.py exists for that. The microphone behaves
      differently, and it was tested rather than assumed.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>__VENVBIN__/python3</string>
        <string>-m</string>
        <string>kavach.voice</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__BRAIN__</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it dies, but not in a tight loop: a crash-looping process
         that holds the microphone is worse than one that stays down. -->
    <!--
      Restart however it exits, not only on a crash.

      This was {SuccessfulExit: false} — "come back from a crash, respect a
      clean stop" — on the reasoning that a process holding the microphone
      should stay stopped when you stop it. It exited cleanly at 16:37:50 with
      no error, no traceback and no crash report; launchd left it down, and the
      orb went on showing scripted demo data for ten minutes as though the
      brain were alive.

      The reasoning named the wrong stop mechanism. A deliberate stop is
      `launchctl bootout gui/$UID/com.krishna.kavach`, which unloads the job
      whatever this says. Leaving a clean exit unhandled only covered a case
      nobody asked for, at the cost of the one that happened.
    -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__LOGS__/voice.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/voice.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Homebrew + uv, since launchd starts with a minimal PATH and the
             MCP servers are launched via npx/uvx. -->
        <key>PATH</key>
        <string>__NODEBIN__:/Users/krishnamathurm4pro/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Nice-d down: this runs all day, and Whisper should not fight the
         foreground app for CPU while idle. -->
    <key>ProcessType</key>
    <string>Adaptive</string>
</dict>
</plist>
